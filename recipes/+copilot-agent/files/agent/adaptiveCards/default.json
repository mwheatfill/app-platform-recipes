{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "${title}",
          "weight": "Bolder",
          "size": "Medium",
          "wrap": true,
          "$when": "${exists(title)}"
        },
        {
          "type": "TextBlock",
          "text": "${subtitle}",
          "isSubtle": true,
          "wrap": true,
          "spacing": "Small",
          "$when": "${exists(subtitle)}"
        }
      ]
    },
    {
      "type": "Container",
      "$data": "${items}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "Image",
                  "url": "${photoUrl}",
                  "size": "Small",
                  "style": "Person",
                  "$when": "${exists(photoUrl)}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${name}",
                  "weight": "Bolder",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${role}",
                  "isSubtle": true,
                  "wrap": true,
                  "spacing": "None",
                  "$when": "${exists(role)}"
                },
                {
                  "type": "TextBlock",
                  "text": "${detail}",
                  "wrap": true,
                  "spacing": "Small",
                  "$when": "${exists(detail)}"
                }
              ]
            }
          ]
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.OpenUrl",
              "title": "Email",
              "url": "mailto:${email}",
              "$when": "${exists(email)}"
            },
            {
              "type": "Action.OpenUrl",
              "title": "Teams chat",
              "url": "https://teams.microsoft.com/l/chat/0/0?users=${email}",
              "$when": "${exists(email)}"
            }
          ],
          "$when": "${exists(email)}"
        }
      ],
      "separator": true,
      "spacing": "Medium"
    }
  ]
}
