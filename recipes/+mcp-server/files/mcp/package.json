{
  "name": "mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mcp-server": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
