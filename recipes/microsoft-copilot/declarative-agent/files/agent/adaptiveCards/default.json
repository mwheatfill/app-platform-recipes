{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "${avatarUrl}",
              "size": "Small",
              "style": "Person",
              "$when": "${exists(avatarUrl)}"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "weight": "Bolder",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "${subtitle}",
              "isSubtle": true,
              "spacing": "None",
              "wrap": true,
              "$when": "${exists(subtitle)}"
            },
            {
              "type": "TextBlock",
              "text": "${detail}",
              "wrap": true,
              "spacing": "Small",
              "$when": "${exists(detail)}"
            },
            {
              "type": "TextBlock",
              "text": "${email}",
              "isSubtle": true,
              "wrap": true,
              "spacing": "Small",
              "$when": "${exists(email)}"
            },
            {
              "type": "TextBlock",
              "text": "${status}",
              "isSubtle": true,
              "wrap": true,
              "spacing": "Small",
              "$when": "${exists(status)}"
            }
          ]
        }
      ]
    }
  ]
}
